TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
TEXT_MODEL_BASE_URL=https://api.cerebras.ai/v1
TEXT_MODEL=gpt-oss-120b
TEXT_MODEL_API_KEY=
TEXT_MODEL_REASONING=none
CEREBRAS_API_KEY=
# Non-Chrome browser (Thorium, etc.): relaunch it with --remote-debugging-port=9222, then:
# BU_CDP_URL=http://127.0.0.1:9222
HOLLER_PTT_KEY=alt_r
HOLLER_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# DEEPGRAM_API_KEY=       # set = Deepgram nova-3 STT + Aura TTS instead of local whisper/`say`
# DEEPGRAM_MODEL=aura-2-thalia-en
# HOLLER_VOICE=Samantha   # any name from `say -v '?'`; unset = macOS system voice
# HOLLER_FOREGROUND=1     # bring the agent's tab to the front while it works
# HOLLER_KEEP_TAB=1       # leave the result tab open instead of closing it
# HOLLER_RECORD=1         # save a screenshot per step into runs/
# HOLLER_AGENT=jev        # default: Jev brain on browser-use DOM/hands; jev = original thin driver
# HOLLER_SETTLE_S=4       # max seconds to wait for a page to render before the first look
# HOLLER_OBSERVE_TIMEOUT=12  # seconds per DOM observation before the step is abandoned
